import sys
e_counter = 0
z_counter = 0

while (ch := sys.stdin.read(1)) != "":
    if ch == 'e':
        e_counter  += 1

    elif ch == 'E':
        e_counter  += 1

    elif ch == 'z':
        z_counter  += 1

    elif ch == 'Z':
        z_counter  += 1

    else:
        continue


print("%d" % e_counter)

print("%d" % z_counter)
