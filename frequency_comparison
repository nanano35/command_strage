import sys
e_counter = 0
z_counter = 0

while (ch := sys.stdin.read(1)) != "":
    if ch == 'e':
        e_counter  += 1

    elif ch == 'E':
        e_counter  += 1

    elif ch == 'z':
        z_counter  += 1

    elif ch == 'Z':
        z_counter  += 1

    else:
        continue

if z_counter == 0:
    sys.exit(1)

ratio = e_counter / z_counter 

print("%.2f" % ratio)

